[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/ui/settings_panel.gd" id="1"]
[ext_resource type="Texture2D" path="res://assets/ui/icons/talents.png" id="2"]

[node name="SettingsPanel" type="PanelContainer"]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -600.0
offset_top = -150.0
offset_right = 600.0
offset_bottom = 150.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"PanelSection"
script = ExtResource("1")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Header" type="HBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="TitleIcon" type="TextureRect" parent="VBox/Header"]
custom_minimum_size = Vector2(20, 20)
layout_mode = 2
size_flags_vertical = 4
texture = ExtResource("2")
expand_mode = 1
stretch_mode = 5

[node name="Title" type="Label" parent="VBox/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 16
text = "Настройки"

[node name="CloseButton" type="Button" parent="VBox/Header"]
unique_name_in_owner = true
custom_minimum_size = Vector2(18, 17)
layout_mode = 2
size_flags_vertical = 4
