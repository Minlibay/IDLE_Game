[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/ui/needs_panel.gd" id="1"]
[ext_resource type="Texture2D" path="res://assets/ui/icons/rest.png" id="2"]

[node name="NeedsPanel" type="PanelContainer"]
offset_right = 200.0
offset_bottom = 60.0
theme_type_variation = &"PanelSmall"
script = ExtResource("1")

[node name="HBox" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="NeedBars" type="VBoxContainer" parent="HBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
theme_override_constants/separation = 3

[node name="RestButton" type="Button" parent="HBox"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Отправить героя отдыхать (восстанавливает бодрость).
Волна встаёт на паузу."
theme_override_constants/icon_max_width = 18
text = "Отдых"
icon = ExtResource("2")
