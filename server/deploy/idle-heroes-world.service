# systemd-служба сервера мировой карты.
# Установка: sudo cp idle-heroes-world.service /etc/systemd/system/
#            sudo systemctl daemon-reload && sudo systemctl enable --now idle-heroes-world
# Логи:      journalctl -u idle-heroes-world -f

[Unit]
Description=Desktop Idle Heroes — world map server
After=network.target

[Service]
Type=simple
User=idleheroes
WorkingDirectory=/opt/idle-heroes/server
# Слушаем только localhost — наружу сервер отдаёт nginx (HTTPS).
# Без nginx/домена: HOST=0.0.0.0 и открыть порт 8787 в ufw (трафик будет без шифрования).
Environment=HOST=127.0.0.1
Environment=PORT=8787
Environment=DB_PATH=/var/lib/idle-heroes/world.db
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning src/main.ts
Restart=always
RestartSec=3

# Минимальные права.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/idle-heroes
PrivateTmp=true

[Install]
WantedBy=multi-user.target
